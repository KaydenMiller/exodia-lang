<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>

        <LangVersion>14</LangVersion>

        <RootNamespace>Exodia.Lang.Test</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" Version="1.61.15"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Exodia.Lang\Exodia.Lang.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Exodia source fixtures copied next to the test binary so Fixtures.Load can read them. -->
        <None Include="Fixtures\**\*.ex" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
