{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Exodia",
  "scopeName": "source.exodia",
  "fileTypes": ["ex"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.exodia",
          "match": "//.*$"
        },
        {
          "name": "comment.block.exodia",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.exodia",
          "match": "\\b(if|else|while|do|for|return|match|when|panic|give)\\b"
        },
        {
          "name": "storage.type.exodia",
          "match": "\\b(fn|struct|class|interface|impl|enum|namespace|ctor)\\b"
        },
        {
          "name": "storage.modifier.exodia",
          "match": "\\b(public|private|protected|internal|global|static|mut|const|dyn)\\b"
        },
        {
          "name": "keyword.other.exodia",
          "match": "\\b(new|as|extends|where)\\b"
        },
        {
          "name": "variable.language.exodia",
          "match": "\\b(this|super)\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.exodia",
          "match": "\\b(true|false)\\b"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.exodia",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.exodia" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.exodia" }
      }
    },

    "chars": {
      "name": "string.quoted.single.exodia",
      "match": "'([^'\\\\\\r\\n]|\\\\['\"\\\\0nrt])'",
      "captures": {
        "1": { "name": "constant.character.escape.exodia" }
      }
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.exodia",
          "match": "\\b[0-9](?:[0-9_]*[0-9])?\\.[0-9](?:[0-9_]*[0-9])?(?:[eE][+-]?[0-9](?:[0-9_]*[0-9])?)?(?:[fdm])?\\b"
        },
        {
          "name": "constant.numeric.integer.exodia",
          "match": "\\b[0-9](?:[0-9_]*[0-9])?(?:[iu](?:8|16|32|64))?\\b"
        }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+(@?[\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "storage.type.function.exodia" },
            "2": { "name": "entity.name.function.exodia" }
          }
        },
        {
          "match": "\\b(ctor)\\s+(@?[\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": { "name": "storage.type.exodia" },
            "2": { "name": "entity.name.function.constructor.exodia" }
          }
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.exodia",
          "match": "\\b(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float|double|bool|char|void)\\b"
        },
        {
          "name": "entity.name.type.exodia",
          "match": "\\b[A-Z][\\p{L}\\p{N}_]*\\b"
        }
      ]
    },

    "calls": {
      "patterns": [
        {
          "match": "\\b([a-z_][\\p{L}\\p{N}_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.exodia" }
          }
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.exodia",
          "match": "=>|->|::|\\.\\.|!!|\\|\\||&&|[*/+\\-]=|[=!]=|<=|>=|[-+*/<>=!?|&:.]"
        }
      ]
    }
  }
}
