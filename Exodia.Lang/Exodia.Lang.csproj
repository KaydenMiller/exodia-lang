<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <LangVersion>14</LangVersion>
        <RootNamespace>Exodia.Lang</RootNamespace>
        <NoWarn>$(NoWarn);CS3021</NoWarn>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
        <PackageReference Include="libLLVM.runtime.linux-x64" Version="21.1.8" />
        <PackageReference Include="LLVMSharp" Version="20.1.2" />
    </ItemGroup>

    <ItemGroup>
        <None Update="tests\sample-script.ex">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
